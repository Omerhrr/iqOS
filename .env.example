# ============================================================================
# iqOS — LLM provider configuration (server-side env, loaded by Next.js)
# Copy to .env (or .env.local) and fill in the providers you want.
# The Copilot brain uses the first enabled provider; the rest act as fallback.
# ============================================================================
# DATABASE_URL=file:./db/custom.db

# --- enable switches (true/false for each, exactly one minimum) -------------
USE_ZAI=true
USE_DEEPSEEK=false
USE_ANTHROPIC=false
USE_OPENAI=false
USE_GEMINI=false
USE_OLLAMA=false

# --- optional priority order (comma-separated). Default: zai first. ----------
# LLM_ORDER=zai,deepseek,anthropic,openai,gemini,ollama

# --- credentials --------------------------------------------------------------
# Z.ai: leave ZAI_API_KEY unset to use the z-ai-web-dev-sdk / .z-ai-config file
# (see .z-ai-config.example). Set it to hit the Z.ai OpenAI-compatible API directly:
# ZAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Ollama is local — no key needed, just the server URL:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_API_KEY=            # only if your Ollama sits behind auth

# --- model overrides (defaults shown) ----------------------------------------
# ZAI_MODEL=glm-4.6
# DEEPSEEK_MODEL=deepseek-chat
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-2.5-flash
# OLLAMA_MODEL=llama3.1

# --- notes --------------------------------------------------------------------
# * web_search (live web tool in Copilot) is a Z.ai gateway function — it only
#   works when USE_ZAI=true. Other providers gracefully skip it.
# * TTS/ASR (voice) routes also ride Z.ai and need USE_ZAI=true or a .z-ai-config.
# * Restart `npm run dev` after changing this file.
