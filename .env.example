# iqOS template - copy to .env and fill in.
# .env is gitignored; .env.example (this file) is committed.

# Copilot LLM (DeepSeek or any OpenAI-compatible endpoint)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Database (Prisma; the trading kernel keeps its own os.db under
# mini-services/trading-core/data/)
DATABASE_URL=

# Optional overrides
# KERNEL_URL=http://127.0.0.1:3030
# KERNEL_PORT=3030
# SIDECAR_PORT=8788

# P0 security: shared kernel token. When set, the trading kernel rejects
# every REST call without it (x-kernel-token / Bearer / ?token=), the web app
# injects it server-side (never in the browser), and state-changing calls +
# auth rejections land in the kernel's data/audit.jsonl. Leave unset for
# local dev (open surface). Generate with: openssl rand -hex 24
# KERNEL_TOKEN=
